// The game demos' cells and Mob Pit's rooms for `celld dev` (and `celld
// deploy`). The launcher (`examples/game/run.sh`, the test harnesses) writes
// `.dev.vars` beside a copy of this file with DISTRIBUTED_INTERNAL_SECRET,
// GAME_TICKET_SECRET (shared with whoever mints room tickets) and
// CELLD_QUEUE_RELAY_URL (the services' `/internal/celld-queue/relay`).
{
  "name": "game-demo-cells",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [
      { "name": "CRAWLER", "class_name": "CrawlerCell" },
      { "name": "PRESENCE", "class_name": "PresenceCell" },
      { "name": "ZONE_LEASE", "class_name": "ZoneLeaseCell" },
      { "name": "ZONE_STATE", "class_name": "ZoneStateCell" },
      { "name": "GEM_POUCH", "class_name": "GemPouchCell" },
      { "name": "CONTENT_LOG", "class_name": "ContentLogCell" },
      { "name": "PIT_ROOM", "class_name": "PitRoom" },
      { "name": "ZONE_ACTIVITY", "class_name": "ZoneActivityObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CrawlerCell", "PresenceCell"] },
    { "tag": "v2", "new_sqlite_classes": ["ZoneLeaseCell", "ZoneStateCell"] },
    { "tag": "v3", "new_sqlite_classes": ["GemPouchCell", "ContentLogCell"] },
    { "tag": "v4", "new_sqlite_classes": ["PitRoom", "ZoneActivityObject"] }
  ],
  // Hibernation snapshots above the inline limit (celld's object storage).
  "r2_buckets": [
    { "binding": "ZONE_SNAPSHOTS", "bucket_name": "zone-snapshots" }
  ],
  "queues": {
    "producers": [
      { "binding": "OUTBOX", "queue": "game-demo-outbox" }
    ],
    "consumers": [
      {
        "queue": "game-demo-outbox",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 100,
        "dead_letter_queue": "game-demo-outbox-dlq",
        "retry_delay": 2
      }
    ]
  },
  "vars": {
    "OUTBOX_DRAIN_INTERVAL_MS": "5000",
    // Mob Pit rooms (distributed_game::celld_zone). GAME_TICKET_SECRET comes
    // from .dev.vars (the launcher shares it with the ticket issuer).
    "ZONE_TICK_HZ": "30",
    "ZONE_PATCH_HZ": "20",
    "ZONE_PERSIST_MS": "5000",
    "ZONE_HIBERNATE_AFTER_MS": "10000",
    "ZONE_FACT_SERVICE": "mobpit-rooms"
  }
}
