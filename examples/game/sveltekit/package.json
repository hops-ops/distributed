{
  "name": "game-demos-sveltekit",
  "private": true,
  "version": "0.0.0",
  "description": "Mob Pit in SvelteKit: session tickets, Vite-generated game client, runes HUD (dev only)",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:games": "node scripts/check-games.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@auth/sveltekit": "1.11.3",
    "@hops-ops/distributed": "file:../../../js"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.2.12",
    "@sveltejs/kit": "2.70.1",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@types/node": "^24.7.0",
    "playwright": "1.61.1",
    "svelte": "5.56.7",
    "svelte-check": "4.1.7",
    "typescript": "5.8.3",
    "vite": "6.4.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
