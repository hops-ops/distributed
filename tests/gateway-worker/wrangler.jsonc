{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "application-gateway-local-fixture",
  "main": "build/worker/shim.mjs",
  "compatibility_flags": ["enable_request_signal"],
  "compatibility_date": "2026-09-03",
  "workers_dev": false,
  "durable_objects": {"bindings":[{"name":"DELIVERY","class_name":"DeliveryCoordinator"}]},
  "migrations":[{"tag":"gateway-v1","new_sqlite_classes":["DeliveryCoordinator"]}],
  "build": {"command":"worker-build --dev"},
  "vars": {
    "PUBLIC_ORIGIN": "http://127.0.0.1:8787",
    "UI_ORIGIN": "http://127.0.0.1:3000"
  }
}
